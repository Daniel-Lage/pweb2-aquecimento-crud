<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aquecimento CRUD - Novo Doce</title>
</head>

<body>
  <h1>Novo Doce</h1>
  <a href="/doces"> Voltar para a lista de doces</a>

  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Preço</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <%= candy.nome %>
        </td>
        <td>
          <%= candy.preco %>
        </td>
      </tr>
    </tbody>
  </table>

  <form action="/doces/<%= candy.id %>/excluir" method="POST">
    <button type="submit">Excluir</button>
  </form>

  <form action="/doces/<%= candy.id %>" method="POST">
    <label for="preco">Preço:</label>
    <input type="number" id="preco" name="preco" required />

    <button type=" submit">Atualizar</button>
  </form>


</body>

</html>